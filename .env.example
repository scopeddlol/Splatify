# Documentation placeholders only. Replace before starting Compose.
# Generate separate values with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_VALUE_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://splatify:REPLACE_WITH_THE_SAME_DATABASE_PASSWORD@127.0.0.1:5432/splatify
APP_URL=https://splatify.your-domain.tld
APP_DOMAIN=splatify.your-domain.tld
ADMIN_EMAIL=REPLACE_WITH_YOUR_EMAIL
ADMIN_NAME=Administrator
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
# Use 1 only when every request comes through a proxy replacing X-Forwarded-For.
TRUST_PROXY=0
# Local builds: splatify:local. Production: CI writes .deploy.env with a SHA tag.
SPLATIFY_IMAGE=splatify:local
# Uncomment only if this host should run Caddy (ports 80/443 must be free).
# COMPOSE_PROFILES=tls
# Disposable database only; integration tests must never target production.
# TEST_DATABASE_URL=postgresql://splatify:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5432/splatify_test
